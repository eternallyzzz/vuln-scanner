# VulnScanner 环境变量模板
# 复制为 .env 并填入自己的密钥；服务器通过 ${ENV} 语法读取进程环境变量。
# 注意：服务器不自动加载 .env 文件，需将变量导出到服务进程环境
# （Windows: setx / 服务管理器环境变量；Linux: systemd Environment= / export）。

# NVD CVE 数据源 key（可选）：https://nvd.nist.gov/developers/request-an-api-key
# 不设置也能用，但限速 2 秒/请求；设置后提速至 0.6 秒/请求。
NVD_API_KEY=

# CVE 数据源刷新周期与缓存 TTL 在 server.yaml 的 cve 段配置（默认值）：
# msrc_refresh_minutes: 60
# nvd_refresh_hours: 3
# osv_refresh_hours: 6
# debian_refresh_hours: 6
# redhat_refresh_hours: 24
# msrc_ttl_hours: 720
# nvd_ttl_hours: 168
# osv_ttl_hours: 12
# debian_ttl_hours: 168
# redhat_ttl_hours: 24

# LLM 分析（可选，server.yaml 中 llm.provider 非空时启用）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 告警 SMTP 发送密码（server.yaml alerting.smtp.password_env）
SMTP_PASSWORD=

# LDAP 目录登录（可选；全部留空或 LDAP_ENABLED=false 时不启用）
# 服务账号密码只从环境变量读取，不写入 server.yaml
LDAP_ENABLED=false
LDAP_URL=ldap://ldap.example.com:389
LDAP_TLS_SKIP_VERIFY=false
LDAP_BIND_DN=cn=admin,dc=example,dc=org
LDAP_BIND_PASSWORD=
# 默认直接用 LDAP_BIND_PASSWORD；可改为其它环境变量名
LDAP_BIND_PASSWORD_ENV=LDAP_BIND_PASSWORD
LDAP_USER_BASE_DN=ou=users,dc=example,dc=org
LDAP_USER_FILTER=(uid={username})
LDAP_GROUP_BASE_DN=ou=groups,dc=example,dc=org
LDAP_GROUP_FILTER=(member={dn})
# JSON：{"admin":["cn=admins,dc=example,dc=org"],"operator":["cn=ops,dc=example,dc=org"],"viewer":["viewers"]}
LDAP_ROLE_GROUPS=
LDAP_AUTO_PROVISION=true
LDAP_TIMEOUT_SECONDS=10

# 凭据远程扫描（可选；AES-256 主密钥仅从环境变量读取，hex/base64 32 字节）
REMOTE_SCAN_ENABLED=false
REMOTE_SCAN_MASTER_KEY=
# 默认直接用 REMOTE_SCAN_MASTER_KEY；可改为其它环境变量名
REMOTE_SCAN_MASTER_KEY_ENV=REMOTE_SCAN_MASTER_KEY
REMOTE_SCAN_TIMEOUT_SECONDS=30
REMOTE_SCAN_CONCURRENCY=8

# 工单集成（可选；Jira/ServiceNow 告警自动建单，需同时 alerting.enabled: true）
TICKET_ENABLED=false
TICKET_PROVIDER=jira
TICKET_BASE_URL=https://jira.example.com
TICKET_USERNAME=svc-vulnscan@example.com
TICKET_PASSWORD=
# 默认直接用 TICKET_PASSWORD；可改为其它环境变量名
TICKET_PASSWORD_ENV=TICKET_PASSWORD
TICKET_TIMEOUT_SECONDS=15
TICKET_TLS_SKIP_VERIFY=false
# Jira
TICKET_PROJECT=SEC
TICKET_ISSUE_TYPE=Task
TICKET_JIRA_ACK_TRANSITION_ID=
TICKET_JIRA_RESOLVED_TRANSITION_ID=
# ServiceNow
TICKET_SERVICENOW_TABLE=incident
TICKET_SERVICENOW_ACK_STATE=2
TICKET_SERVICENOW_RESOLVED_STATE=6

# SIEM/SOAR 事件流（可选；告警+补丁事件经 outbox 投递）
SIEM_ENABLED=false
SIEM_SPLUNK_HEC_URL=https://splunk.example.com:8088/services/collector/event
SIEM_SPLUNK_HEC_TOKEN=
# 默认直接用 SIEM_SPLUNK_HEC_TOKEN；可改为其它环境变量名
SIEM_SPLUNK_HEC_TOKEN_ENV=SIEM_SPLUNK_HEC_TOKEN
SIEM_SPLUNK_HEC_INDEX=vulnscan
SIEM_SPLUNK_HEC_SOURCETYPE=vulnscan:events
SIEM_WEBHOOK_URL=
SIEM_WEBHOOK_SECRET=
# 默认直接用 SIEM_WEBHOOK_SECRET；可改为其它环境变量名
SIEM_WEBHOOK_SECRET_ENV=SIEM_WEBHOOK_SECRET
SIEM_DELIVERY_INTERVAL_SECONDS=10
SIEM_BATCH_SIZE=50
SIEM_MAX_ATTEMPTS=3
SIEM_TIMEOUT_SECONDS=10
SIEM_TLS_SKIP_VERIFY=false

# 计划报表（可选；SMTP 服务器/认证复用 alerting.smtp，REPORTING_TO 为逗号分隔收件人）
REPORTING_ENABLED=false
REPORTING_SCHEDULE=0 8 * * *
REPORTING_TIMEZONE=Local
REPORTING_TO=

# 服务端鉴权（必改，与 server.yaml 中的 ${JWT_SECRET} / ${API_KEY} 对应）
JWT_SECRET=change-me-in-production
API_KEY=sk-change-me

# 控制台用户首启引导：users 表为空且 ADMIN_PASSWORD 非空时创建第一个 admin。
# 不设置则控制台登录不可用（X-API-Key 自动化通道不受影响）。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
