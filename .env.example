# VulnScanner 环境变量模板
# 复制为 .env 并填入自己的密钥；服务器通过 ${ENV} 语法读取进程环境变量。
# 注意：服务器不自动加载 .env 文件，需将变量导出到服务进程环境
# （Windows: setx / 服务管理器环境变量；Linux: systemd Environment= / export）。

# NVD CVE 数据源 key（可选）：https://nvd.nist.gov/developers/request-an-api-key
# 不设置也能用，但限速 2 秒/请求；设置后提速至 0.6 秒/请求。
NVD_API_KEY=

# LLM 分析（可选，server.yaml 中 llm.provider 非空时启用）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 告警 SMTP 发送密码（server.yaml alerting.smtp.password_env）
SMTP_PASSWORD=

# 服务端鉴权（必改，与 server.yaml 中的 ${JWT_SECRET} / ${API_KEY} 对应）
JWT_SECRET=change-me-in-production
API_KEY=sk-change-me
