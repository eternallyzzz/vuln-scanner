# VulnScanner environment template - Core Profile
# Copy to .env and fill in your own secrets. The server loads server.yaml by
# default; these variables override core settings in the container.

# Run mode: all (default, API + gRPC + background loops) | api | worker
VULNSCAN_MODE=all

# CVE feed key (optional; without it NVD is still usable at 2 req/s)
NVD_API_KEY=

# Core alerting. Enabled by default with internal alert records; add a
# webhook URL/secret to deliver notifications.
ALERTING_ENABLED=true
ALERTING_WEBHOOK_URL=
ALERTING_WEBHOOK_SECRET=

# SMTP password used by alerting.smtp / reporting.smtp (optional)
SMTP_PASSWORD=

# Core patch deployment. Dry-run and approval are on by default for safety.
PATCH_ENABLED=true
PATCH_DRY_RUN=true
PATCH_DEFAULT_APPROVAL_REQUIRED=true
PATCH_AGENT_TIMEOUT_SECONDS=600

# Server authentication (must be changed in production)
JWT_SECRET=change-me-in-production
API_KEY=sk-change-me

# Control-plane admin bootstrap (users table is empty and ADMIN_PASSWORD is set)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Advanced modules live in .env.advanced.example and are all disabled by default.
