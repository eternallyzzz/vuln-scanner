# VulnScanner environment template - Advanced (Optional) Modules
# These variables are all disabled by default. Set them only when you enable
# the matching block from server.advanced.yaml.example.

# LDAP directory login
LDAP_ENABLED=false
LDAP_URL=ldap://ldap.example.com:389
LDAP_TLS_SKIP_VERIFY=false
LDAP_BIND_DN=cn=admin,dc=example,dc=org
LDAP_BIND_PASSWORD=
LDAP_BIND_PASSWORD_ENV=LDAP_BIND_PASSWORD
LDAP_USER_BASE_DN=ou=users,dc=example,dc=org
LDAP_USER_FILTER=(uid={username})
LDAP_GROUP_BASE_DN=ou=groups,dc=example,dc=org
LDAP_GROUP_FILTER=(member={dn})
LDAP_ROLE_GROUPS=
LDAP_AUTO_PROVISION=true
LDAP_TIMEOUT_SECONDS=10

# Credential-based remote SSH scanning
REMOTE_SCAN_ENABLED=false
REMOTE_SCAN_MASTER_KEY=
REMOTE_SCAN_MASTER_KEY_ENV=REMOTE_SCAN_MASTER_KEY
REMOTE_SCAN_TIMEOUT_SECONDS=30
REMOTE_SCAN_CONCURRENCY=8

# Ticketing integration (Jira/ServiceNow)
TICKET_ENABLED=false
TICKET_PROVIDER=jira
TICKET_BASE_URL=https://jira.example.com
TICKET_USERNAME=svc-vulnscan@example.com
TICKET_PASSWORD=
TICKET_PASSWORD_ENV=TICKET_PASSWORD
TICKET_TIMEOUT_SECONDS=15
TICKET_TLS_SKIP_VERIFY=false
TICKET_PROJECT=SEC
TICKET_ISSUE_TYPE=Task
TICKET_JIRA_ACK_TRANSITION_ID=
TICKET_JIRA_RESOLVED_TRANSITION_ID=
TICKET_SERVICENOW_TABLE=incident
TICKET_SERVICENOW_ACK_STATE=2
TICKET_SERVICENOW_RESOLVED_STATE=6

# SIEM/SOAR event stream
SIEM_ENABLED=false
SIEM_SPLUNK_HEC_URL=https://splunk.example.com:8088/services/collector/event
SIEM_SPLUNK_HEC_TOKEN=
SIEM_SPLUNK_HEC_TOKEN_ENV=SIEM_SPLUNK_HEC_TOKEN
SIEM_SPLUNK_HEC_INDEX=vulnscan
SIEM_SPLUNK_HEC_SOURCETYPE=vulnscan:events
SIEM_WEBHOOK_URL=
SIEM_WEBHOOK_SECRET=
SIEM_WEBHOOK_SECRET_ENV=SIEM_WEBHOOK_SECRET
SIEM_DELIVERY_INTERVAL_SECONDS=10
SIEM_BATCH_SIZE=50
SIEM_MAX_ATTEMPTS=3
SIEM_TIMEOUT_SECONDS=10
SIEM_TLS_SKIP_VERIFY=false

# Cloud asset discovery (AWS/Azure/GCP)
CLOUD_SCAN_ENABLED=false
CLOUD_SCAN_MASTER_KEY=
CLOUD_SCAN_MASTER_KEY_ENV=CLOUD_SCAN_MASTER_KEY
CLOUD_SCAN_CONCURRENCY=2
CLOUD_SCAN_DEFAULT_REFRESH_INTERVAL_MINUTES=60
CLOUD_SCAN_TIMEOUT_SECONDS=30

# Web application / database scanning
WEBDB_SCAN_ENABLED=false
WEBDB_SCAN_MASTER_KEY=
WEBDB_SCAN_MASTER_KEY_ENV=WEBDB_SCAN_MASTER_KEY
WEBDB_SCAN_TIMEOUT_SECONDS=10
WEBDB_SCAN_CONCURRENCY=8
WEBDB_SCAN_TLS_SKIP_VERIFY=true

# Scheduled email reports
REPORTING_ENABLED=false
REPORTING_SCHEDULE=0 8 * * *
REPORTING_TIMEZONE=Local
REPORTING_TO=

# LLM analysis (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
